rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId) && isValidClientUserCreate(userId);
      allow update: if isOwner(userId) && isValidClientUserUpdate();
      allow delete: if isOwner(userId);
    }

    match /badges/{document=**} {
      allow read: if true;
      allow write: if false;
    }

    match /universes/{document=**} {
      allow read: if true;
      allow write: if false;
    }

    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    function isValidClientUserCreate(userId) {
      return request.resource.data.keys().hasOnly([
               'uid',
               'displayName',
               'email',
               'joinedDate',
               'isFounder',
               'showReleaseYears',
               'notifyNewUniverses',
               'currentUniverseID',
               'fcmTokens',
               'selectedUniverseFilters',
               'journeyPositions',
               'unlockedBadges',
               'shownBadgePopups',
               'watchedMovies',
               'skippedMovies',
               'schemaVersion'
             ]) &&
             request.resource.data.keys().hasAll([
               'uid',
               'displayName',
               'email',
               'joinedDate',
               'isFounder',
               'showReleaseYears',
               'notifyNewUniverses',
               'selectedUniverseFilters',
               'journeyPositions',
               'unlockedBadges',
               'shownBadgePopups',
               'watchedMovies',
               'skippedMovies',
               'schemaVersion'
             ]) &&
             request.resource.data.uid == userId &&
             request.resource.data.uid is string &&
             request.resource.data.displayName is string &&
             request.resource.data.email is string &&
             request.resource.data.joinedDate is int &&
             request.resource.data.isFounder == false &&
             request.resource.data.showReleaseYears is bool &&
             request.resource.data.notifyNewUniverses is bool &&
             (!request.resource.data.keys().hasAny(['currentUniverseID']) ||
                request.resource.data.currentUniverseID is string) &&
             (!request.resource.data.keys().hasAny(['fcmTokens']) ||
                request.resource.data.fcmTokens is list) &&
             request.resource.data.selectedUniverseFilters is map &&
             request.resource.data.journeyPositions is map &&
             request.resource.data.unlockedBadges is list &&
             request.resource.data.shownBadgePopups is list &&
             request.resource.data.watchedMovies is list &&
             request.resource.data.skippedMovies is list &&
             request.resource.data.schemaVersion is int;
    }

    function isValidClientUserUpdate() {
      let changedKeys = request.resource.data.diff(resource.data).affectedKeys();

      return changedKeys.hasOnly([
               'displayName',
               'showReleaseYears',
               'notifyNewUniverses',
               'currentUniverseID',
               'fcmTokens',
               'selectedUniverseFilters',
               'journeyPositions',
               'unlockedBadges',
               'shownBadgePopups',
               'watchedMovies',
               'skippedMovies'
             ]) &&
             (!changedKeys.hasAny(['displayName']) ||
               request.resource.data.displayName is string) &&
             (!changedKeys.hasAny(['showReleaseYears']) ||
               request.resource.data.showReleaseYears is bool) &&
             (!changedKeys.hasAny(['notifyNewUniverses']) ||
               request.resource.data.notifyNewUniverses is bool) &&
             (!changedKeys.hasAny(['currentUniverseID']) ||
                !request.resource.data.keys().hasAny(['currentUniverseID']) ||
                request.resource.data.currentUniverseID is string) &&
             (!changedKeys.hasAny(['fcmTokens']) ||
                !request.resource.data.keys().hasAny(['fcmTokens']) ||
                request.resource.data.fcmTokens is list) &&
             (!changedKeys.hasAny(['selectedUniverseFilters']) ||
               isSupportedUniverseFilters(
                 request.resource.data.selectedUniverseFilters
               )) &&
             (!changedKeys.hasAny(['journeyPositions']) ||
               request.resource.data.journeyPositions is map) &&
             (!changedKeys.hasAny(['unlockedBadges']) ||
               request.resource.data.unlockedBadges is list) &&
             (!changedKeys.hasAny(['shownBadgePopups']) ||
               request.resource.data.shownBadgePopups is list) &&
             (!changedKeys.hasAny(['watchedMovies']) ||
               request.resource.data.watchedMovies is list) &&
             (!changedKeys.hasAny(['skippedMovies']) ||
               request.resource.data.skippedMovies is list);
    }

    // Existing Android releases write the pre-schema-v2 flat list. New clients
    // always write the per-universe map, while this grace path avoids breaking
    // installed older releases during rollout.
    function isSupportedUniverseFilters(filters) {
      return filters is map || filters is list;
    }
  }
}
